# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/rasa_hub_product_inventory_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgresql_password

# JWT
# IMPORTANT: Must match auth-people-service JWT_SECRET.
JWT_SECRET=replace_with_the_same_long_random_secret_used_by_auth_service

# Supabase Storage - backend only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_backend_secret_key
SUPABASE_STORAGE_BUCKET=product-images